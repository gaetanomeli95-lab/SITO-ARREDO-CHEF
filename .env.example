# Invio email del modulo contatti (opzionale finché non è configurato).
# Senza queste variabili il form propone automaticamente email precompilata + telefono.

# Chiave API di Resend — https://resend.com
RESEND_API_KEY=

# Mittente verificato su Resend (es. no-reply@arredochefsrls.it)
RESEND_FROM_EMAIL=

# Destinatario delle richieste. Se assente usa info@arredochefsrls.it
CONTACT_TO_EMAIL=
